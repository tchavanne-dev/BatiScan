<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ──────────────────────────────────────────────
         BatiScan – Plugin Revit 2027 (lecture nuage de points)
         Cible : .NET 10 / Windows (Revit 2027 exige Windows)
    ────────────────────────────────────────────── -->
    <AssemblyName>BatiScan</AssemblyName>
    <RootNamespace>BatiScan</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Produit une DLL, pas un exe -->
    <OutputType>Library</OutputType>

    <!-- Répertoire de sortie vers le dossier Addins Revit local (optionnel) -->
    <!-- <OutputPath>$(APPDATA)\Autodesk\Revit\Addins\2027\</OutputPath> -->

    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>BatiScan</Company>
    <Product>BatiScan – Lecture de nuage de points Revit 2027</Product>
    <Copyright>Copyright © 2026 BatiScan</Copyright>
    <Description>Plugin Revit 2027 : inventaire et analyse des nuages de points liés.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
